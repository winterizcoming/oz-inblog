{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oz-inblog-automation.local/schema/brunch-chat-response.schema.json",
  "title": "Oz Brunch Chat Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["markdown", "choices"],
  "allOf": [
    {
      "if": {
        "properties": {
          "choices": { "contains": {} }
        }
      },
      "then": { "required": ["question"] }
    }
  ],
  "properties": {
    "markdown": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "choices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "description"],
        "properties": {
          "label": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "description": { "type": "string", "minLength": 1, "pattern": "\\S" }
        }
      }
    },
    "question": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "writing_preview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "markdown"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "subtitle": { "type": "string" },
        "markdown": { "type": "string", "minLength": 1, "pattern": "\\S" }
      }
    }
  }
}
